{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knoop.local/schemas/knoop-backup-v1.schema.json",
  "title": "Knoop Backup 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "appVersion",
    "exportedAt",
    "tables",
    "counts",
    "sequences",
    "preferences",
    "integrity"
  ],
  "properties": {
    "format": {
      "const": "knoop-backup"
    },
    "version": {
      "const": "1.0"
    },
    "appVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "exportedAt": {
      "type": "string",
      "minLength": 1
    },
    "tables": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "banks",
        "nodes",
        "questions",
        "sessions",
        "attempts",
        "favorites",
        "killed_questions",
        "notes",
        "question_reviews",
        "question_answer_revisions",
        "ai_review_groups",
        "ai_review_batch_jobs"
      ],
      "properties": {
        "banks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "created_at",
              "updated_at"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "created_at": {
                "type": "string"
              },
              "updated_at": {
                "type": "string"
              }
            }
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "external_id",
              "bank_id",
              "parent_id",
              "title",
              "sort_order"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "external_id": {
                "type": "string"
              },
              "bank_id": {
                "type": "string"
              },
              "parent_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "title": {
                "type": "string"
              },
              "sort_order": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            }
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "external_id",
              "bank_id",
              "node_id",
              "type",
              "sort_order",
              "content_json",
              "tags_json",
              "source_json"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "external_id": {
                "type": "string"
              },
              "bank_id": {
                "type": "string"
              },
              "node_id": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "sort_order": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "content_json": {
                "type": "string"
              },
              "tags_json": {
                "type": "string"
              },
              "source_json": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "sessions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "mode",
              "scope_json",
              "question_ids_json",
              "current_index",
              "state_json",
              "created_at",
              "updated_at",
              "completed_at"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "mode": {
                "type": "string"
              },
              "scope_json": {
                "type": "string"
              },
              "question_ids_json": {
                "type": "string"
              },
              "current_index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "state_json": {
                "type": "string"
              },
              "created_at": {
                "type": "string"
              },
              "updated_at": {
                "type": "string"
              },
              "completed_at": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "question_id",
              "session_id",
              "user_answer",
              "grading_mode",
              "is_correct",
              "answered_at"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "question_id": {
                "type": "string"
              },
              "session_id": {
                "type": "string"
              },
              "user_answer": {
                "type": "string"
              },
              "grading_mode": {
                "type": "string"
              },
              "is_correct": {
                "enum": [
                  0,
                  1
                ]
              },
              "answered_at": {
                "type": "string"
              }
            }
          }
        },
        "favorites": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question_id",
              "created_at"
            ],
            "properties": {
              "question_id": {
                "type": "string"
              },
              "created_at": {
                "type": "string"
              }
            }
          }
        },
        "killed_questions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question_id",
              "created_at"
            ],
            "properties": {
              "question_id": {
                "type": "string"
              },
              "created_at": {
                "type": "string"
              }
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question_id",
              "content",
              "updated_at"
            ],
            "properties": {
              "question_id": {
                "type": "string"
              },
              "content": {
                "type": "string"
              },
              "updated_at": {
                "type": "string"
              }
            }
          }
        },
        "question_reviews": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question_id",
              "issues_json",
              "note",
              "question_snapshot_json",
              "was_killed_before",
              "created_at",
              "updated_at"
            ],
            "properties": {
              "question_id": {
                "type": "string"
              },
              "issues_json": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "question_snapshot_json": {
                "type": "string"
              },
              "was_killed_before": {
                "enum": [
                  0,
                  1
                ]
              },
              "created_at": {
                "type": "string"
              },
              "updated_at": {
                "type": "string"
              }
            }
          }
        },
        "question_answer_revisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "question_id",
              "last_attempt_id",
              "previous_content_json",
              "updated_content_json",
              "changed_at"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "question_id": {
                "type": "string"
              },
              "last_attempt_id": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "previous_content_json": {
                "type": "string"
              },
              "updated_content_json": {
                "type": "string"
              },
              "changed_at": {
                "type": "string"
              }
            }
          }
        },
        "ai_review_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "source_question_id",
              "source_question_title",
              "model",
              "generated_at",
              "created_at",
              "updated_at",
              "bank_json",
              "question_meta_json",
              "current_index",
              "state_json",
              "results_json",
              "completed_at"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "source_question_id": {
                "type": "string"
              },
              "source_question_title": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "generated_at": {
                "type": "string"
              },
              "created_at": {
                "type": "string"
              },
              "updated_at": {
                "type": "string"
              },
              "bank_json": {
                "type": "string"
              },
              "question_meta_json": {
                "type": "string"
              },
              "current_index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "state_json": {
                "type": "string"
              },
              "results_json": {
                "type": "string"
              },
              "completed_at": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "ai_review_batch_jobs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "model",
              "review_json",
              "batches_json",
              "created_at",
              "updated_at"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "review_json": {
                "type": "string"
              },
              "batches_json": {
                "type": "string"
              },
              "created_at": {
                "type": "string"
              },
              "updated_at": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "banks",
        "nodes",
        "questions",
        "sessions",
        "attempts",
        "favorites",
        "killed_questions",
        "notes",
        "question_reviews",
        "question_answer_revisions",
        "ai_review_groups",
        "ai_review_batch_jobs"
      ],
      "properties": {
        "banks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "nodes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "questions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sessions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "favorites": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "killed_questions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "notes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "question_reviews": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "question_answer_revisions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ai_review_groups": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ai_review_batch_jobs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "sequences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempts",
        "question_answer_revisions"
      ],
      "properties": {
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "question_answer_revisions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "knoop.scopeCollapsed.v1",
        "knoop.enabledBrushTypes.v1",
        "knoop.scopePresets.v2",
        "knoop.recentScopePreset.v2"
      ],
      "properties": {
        "knoop.scopeCollapsed.v1": {
          "type": [
            "string",
            "null"
          ]
        },
        "knoop.enabledBrushTypes.v1": {
          "type": [
            "string",
            "null"
          ]
        },
        "knoop.scopePresets.v2": {
          "type": [
            "string",
            "null"
          ]
        },
        "knoop.recentScopePreset.v2": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "const": "SHA-256"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
