{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knoop.local/schemas/knoop-bundle-v1.schema.json",
  "title": "Knoop Bundle 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "exportedAt", "banks"],
  "properties": {
    "format": { "const": "knoop-bundle" },
    "version": { "const": "1.0" },
    "exportedAt": { "type": "string", "minLength": 1 },
    "banks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/bank" }
    }
  },
  "$defs": {
    "bank": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "version", "import", "nodes", "questions"],
      "properties": {
        "format": { "const": "knoop-bank" },
        "version": { "enum": ["1.0", "1.1"] },
        "import": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "bankId", "bankTitle"],
          "properties": {
            "mode": { "enum": ["new", "merge"] },
            "bankId": { "type": "string", "minLength": 1 },
            "bankTitle": { "type": "string", "minLength": 1 }
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "parentId", "title", "order"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "parentId": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
              "title": { "type": "string", "minLength": 1 },
              "order": { "type": "integer" }
            }
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "nodeId", "type", "order"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "nodeId": { "type": "string", "minLength": 1 },
              "type": { "enum": ["single_choice", "multiple_choice", "blank", "recall", "memorization"] },
              "order": { "type": "integer" }
            }
          }
        }
      }
    }
  }
}
