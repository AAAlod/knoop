{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knoop.local/schemas/knoop-bank-v1.1.schema.json",
  "title": "Knoop Bank 1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "import",
    "nodes",
    "questions"
  ],
  "properties": {
    "format": {
      "const": "knoop-bank"
    },
    "version": {
      "const": "1.1"
    },
    "import": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "bankId",
        "bankTitle"
      ],
      "properties": {
        "mode": {
          "enum": [
            "new",
            "merge"
          ]
        },
        "bankId": {
          "type": "string",
          "minLength": 1
        },
        "bankTitle": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/singleChoice"
          },
          {
            "$ref": "#/$defs/multipleChoice"
          },
          {
            "$ref": "#/$defs/blank"
          },
          {
            "$ref": "#/$defs/recall"
          },
          {
            "$ref": "#/$defs/memorization"
          }
        ]
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "parentId",
        "title",
        "order"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "parentId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer"
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "singleChoice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nodeId",
        "type",
        "order",
        "stem",
        "options",
        "answer"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "nodeId": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer"
        },
        "explanation": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "source": {},
        "type": {
          "const": "single_choice"
        },
        "stem": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "answer": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "multipleChoice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nodeId",
        "type",
        "order",
        "stem",
        "options",
        "answer"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "nodeId": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer"
        },
        "explanation": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "source": {},
        "type": {
          "const": "multiple_choice"
        },
        "stem": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "answer": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "blank": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nodeId",
        "type",
        "order",
        "stem",
        "answer"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "nodeId": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer"
        },
        "explanation": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "source": {},
        "type": {
          "const": "blank"
        },
        "stem": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "type": "string"
        }
      }
    },
    "recall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nodeId",
        "type",
        "order",
        "front",
        "back"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "nodeId": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer"
        },
        "explanation": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "source": {},
        "type": {
          "const": "recall"
        },
        "front": {
          "type": "string",
          "minLength": 1
        },
        "back": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "memorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nodeId",
        "type",
        "order",
        "prompt",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "nodeId": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer"
        },
        "explanation": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "source": {},
        "type": {
          "const": "memorization"
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "keyPoints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
